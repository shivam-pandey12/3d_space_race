# Client
VITE_MULTIPLAYER_URL=https://your-multiplayer-host.example.com
VITE_API_BASE_URL=https://your-multiplayer-host.example.com
VITE_SPACESHIP_EDITION=GAMEHUB_LITE
VITE_ENABLE_PAYMENTS=false
VITE_RAZORPAY_KEY_ID=rzp_test_public_key_id_only
VITE_ENABLE_DEMO_ENTITLEMENT=false
VITE_ENABLE_PRIVATE_TOURNAMENTS=false
VITE_ENABLE_BACKEND_EVENTS=false
VITE_ENABLE_GLOBAL_EVENT_LEADERBOARDS=false

# Firebase web config for Google sign-in and cloud profile sync.
# These are public Firebase web app identifiers, not Admin secrets.
# Leave blank for local-only guest mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Server
PORT=3001
NODE_ENV=production

# Comma-separated list of allowed browser origins for Socket.IO in production.
MULTIPLAYER_ALLOWED_ORIGINS=https://your-game.example.com,https://www.your-game.example.com
GAMEHUB_ALLOWED_ORIGINS=https://your-game.example.com,https://www.your-game.example.com

# Payments and backend entitlements.
# Production with ENABLE_PAYMENTS=true requires all Razorpay secrets below plus
# Firebase Admin/Firestore entitlement storage. Never put secret values in Vite
# env vars or frontend code.
ENABLE_PAYMENTS=false
ENABLE_BACKEND_ENTITLEMENTS=false
ENABLE_PRIVATE_TOURNAMENT_ROOMS=false
ENABLE_BACKEND_EVENT_SCHEDULER=false
ENABLE_GLOBAL_EVENT_LEADERBOARDS=false
PAYMENT_ENV=test
RAZORPAY_KEY_ID=rzp_test_public_key_id
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional legacy migration helper. Keep false unless you intentionally convert
# old paid records without expiresAt into 120-day seasonal passes.
ENABLE_LEGACY_PASS_MIGRATION=false

# Set to false in production. Local development may leave this true if you do not
# have Firebase Admin credentials configured yet.
ALLOW_INSECURE_LOCAL_AUTH=false

# Firebase Admin credentials. Use one of these server-only options.
# Never commit real service account JSON, private keys, or base64 credentials.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_BASE64=base64_encoded_service_account_json
# FIREBASE_PROJECT_ID=spaceshipwar-4b274
# GOOGLE_CLOUD_PROJECT=spaceshipwar-4b274
# GCLOUD_PROJECT=spaceshipwar-4b274

# Multiplayer now uses Firebase-backed shared room/profile/queue state whenever
# Firebase Admin is configured. Make sure Firestore is enabled in that project.
