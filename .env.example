# Frontend build env
VITE_API_BASE_URL=https://spaceship.mhhorizons.com
VITE_MULTIPLAYER_URL=https://spaceship.mhhorizons.com
VITE_SPACESHIP_EDITION=GAMEHUB_LITE
VITE_ENABLE_DEMO_ENTITLEMENT=false

# Razorpay Checkout uses only the public key in the browser.
VITE_ENABLE_PAYMENTS=true
VITE_RAZORPAY_KEY_ID=

VITE_ENABLE_PRIVATE_TOURNAMENTS=true
VITE_ENABLE_BACKEND_EVENTS=true
VITE_ENABLE_GLOBAL_EVENT_LEADERBOARDS=true

# Firebase web config for Google sign-in and cloud profile sync.
# These are public Firebase web app identifiers, not Admin secrets.
# Leave blank for local-only guest mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Backend env
NODE_ENV=production
PORT=3001
ALLOW_INSECURE_LOCAL_AUTH=false

GAMEHUB_ALLOWED_ORIGINS=https://spaceship.mhhorizons.com
MULTIPLAYER_ALLOWED_ORIGINS=https://spaceship.mhhorizons.com

# Payments and backend entitlements.
# Real paid access is enabled only when the backend host has these values set.
# Never commit real Razorpay secrets to GitHub.
ENABLE_PAYMENTS=true
ENABLE_BACKEND_ENTITLEMENTS=true
PAYMENT_ENV=live
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Premium online systems.
ENABLE_PRIVATE_TOURNAMENT_ROOMS=true
ENABLE_BACKEND_EVENT_SCHEDULER=true
ENABLE_GLOBAL_EVENT_LEADERBOARDS=true
ENABLE_LEGACY_PASS_MIGRATION=false

# Firebase Admin credentials. Use one server-only option on the backend host.
# Never commit service account JSON, private keys, or base64 credentials.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=
GCLOUD_PROJECT=
