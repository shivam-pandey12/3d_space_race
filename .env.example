# Frontend build env
VITE_API_BASE_URL=https://your-backend-domain.com
VITE_MULTIPLAYER_URL=https://your-backend-domain.com
VITE_SPACESHIP_EDITION=GAMEHUB_LITE
VITE_ENABLE_DEMO_ENTITLEMENT=false

# Razorpay Checkout uses only the public key in the browser.
VITE_ENABLE_PAYMENTS=true
VITE_RAZORPAY_KEY_ID=rzp_live_your_public_key_id

VITE_ENABLE_PRIVATE_TOURNAMENTS=true
VITE_ENABLE_BACKEND_EVENTS=true
VITE_ENABLE_GLOBAL_EVENT_LEADERBOARDS=true

# Firebase web config for Google sign-in and cloud profile sync.
# These are public Firebase web app identifiers, not Admin secrets.
# Leave blank for local-only guest mode.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Backend env
NODE_ENV=production
PORT=3001
ALLOW_INSECURE_LOCAL_AUTH=false

GAMEHUB_ALLOWED_ORIGINS=https://your-frontend-domain.com
MULTIPLAYER_ALLOWED_ORIGINS=https://your-frontend-domain.com

# Payments and backend entitlements.
# Real paid access is enabled only when the backend host has these values set.
# Never commit real Razorpay secrets to GitHub.
ENABLE_PAYMENTS=true
ENABLE_BACKEND_ENTITLEMENTS=true
PAYMENT_ENV=live
RAZORPAY_KEY_ID=rzp_live_your_public_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Premium online systems.
ENABLE_PRIVATE_TOURNAMENT_ROOMS=true
ENABLE_BACKEND_EVENT_SCHEDULER=true
ENABLE_GLOBAL_EVENT_LEADERBOARDS=true
ENABLE_LEGACY_PASS_MIGRATION=false

# Firebase Admin credentials. Use JSON only on the backend host.
# Never commit service account JSON, private keys, or local .env files.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com"}
FIREBASE_PROJECT_ID=your-project-id
GOOGLE_CLOUD_PROJECT=your-project-id
GCLOUD_PROJECT=your-project-id
env